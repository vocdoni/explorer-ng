{
  "name": "explorer-ng",
  "private": true,
  "version": "0.1.0",
  "description": "Block explorer and vote verification UI for the Vocdoni voting protocol",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vocdoni/explorer-ng.git"
  },
  "homepage": "https://github.com/vocdoni/explorer-ng#readme",
  "bugs": {
    "url": "https://github.com/vocdoni/explorer-ng/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "chakra typegen ./src/theme/system.ts && vite build",
    "lint": "tsc --noEmit && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --port 4173",
    "check:results": "node scripts/check-results.mjs",
    "chakra:typegen": "chakra typegen ./src/theme/system.ts",
    "postinstall": "chakra typegen ./src/theme/system.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@fontsource/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-query-devtools": "^5.59.16",
    "@vocdoni/api-types": "^1.1.2",
    "@vocdoni/ballot": "^1.0.0",
    "blakejs": "^1.2.1",
    "date-fns": "^4.4.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.12.7",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
