# Copy to .env and adjust. Used by `npm run dev` (Vite reads VOCONE_* directly)
# and by docker compose, which passes these into the container entrypoint.

# Base URL of the Vocdoni gateway v2 API.
# A bare host is accepted and normalised, so `https://api.vocdoni.io` is
# expanded to `https://api.vocdoni.io/v2`.
# Local node: http://localhost:9090/v2
VOCONE_API_URL=https://api.vocdoni.io/v2

# Poll interval in milliseconds for live chain queries. Values below 15000 are
# clamped to 15000 to keep load on public gateways bounded.
VOCONE_REFRESH_MS=15000

# Host port published by docker compose (container always listens on 80).
EXPLORER_PORT=8080
