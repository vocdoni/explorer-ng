# Reinstalled inside the image by `pnpm install`; copying the host tree would
# also drag in platform-specific native binaries.
node_modules
dist
.pnpm-store

.git
.gitignore
.github

# Secrets and local overrides must never reach the build context.
.env
.env.*
!.env.example

# Local tooling and test artifacts.
.design
.playwright-mcp
coverage
*.tsbuildinfo
.vscode
.idea
*.log
pnpm-debug.log*

Dockerfile
docker-compose.yml
.dockerignore
README.md
